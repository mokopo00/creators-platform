# Copy to .dev.vars for local development. Never commit real values.
# Runtime environment: development | test | staging | production
ENVIRONMENT=
# Public origin of the app (e.g. http://localhost:8787)
APP_ORIGIN=
# Enables mock login. Only honoured when ENVIRONMENT is development or test.
MOCK_AUTH=
# HMAC secret for session cookies and signed upload URLs (32+ random bytes)
SESSION_SECRET=
# Google OAuth 2.0 (staging client only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated allow-list of redirect URIs
OAUTH_REDIRECT_URIS=
# Stripe TEST MODE keys only (sk_test_ / whsec_). sk_live_ is rejected at runtime.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Feature flags / settings
ALLOW_AI_GENERATED=false
PREMIUM_PRICE_JPY=800
PREMIUM_PRICE_TAX_LABEL=税込
PLATFORM_FEE_RATE=0.10
DIGITAL_SALES_FEE_RATE=0.15
# 特定商取引法に基づく表記 (operator info). Set via secrets, never in the repo.
BUSINESS_NAME=
BUSINESS_ADDRESS=
BUSINESS_PHONE=
BUSINESS_CONTACT=
